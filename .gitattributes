# Shell scripts run on Linux, so they keep LF even in Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf

# sqlx checksums include line endings. The live database recorded 0001 and
# 0002 with CRLF and every later migration with LF, so each checkout keeps
# exactly those bytes. A test in apps/api pins the checksums.
apps/api/migrations/*.sql text eol=lf
apps/api/migrations/0001_initial_schema.sql text eol=crlf
apps/api/migrations/0002_drop_ip_columns.sql text eol=crlf
