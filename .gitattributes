# Shell scripts run on Linux, so they keep LF even in Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf

# sqlx checksums include line endings, and the live database was migrated
# with CRLF files. Every checkout keeps them CRLF so any build matches it.
apps/api/migrations/*.sql text eol=crlf
