# Shell scripts run on Linux, so they keep LF even in Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
# The server setup runs on Linux too.
deploy/server/* text eol=lf
*.py text eol=lf
PKGBUILD text eol=lf
packaging/winget/*.yaml text eol=lf
.SRCINFO text eol=lf
# The desktop migrations too, so every build stores the same statements.
apps/desktop/src-tauri/migrations/*.sql text eol=lf

# sqlx checksums include line endings. Databases recorded 0001 and 0002 with
# CRLF and every later migration with LF, so each checkout keeps exactly those
# bytes. A test in apps/api pins the checksums.
apps/api/migrations/*.sql text eol=lf
apps/api/migrations/0001_initial_schema.sql text eol=crlf
apps/api/migrations/0002_drop_ip_columns.sql text eol=crlf
