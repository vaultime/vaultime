{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultime",
  "version": "0.2.0",
  "identifier": "com.vaultime.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vaultime",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://vaultime.codfishcloud.de; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-or-later",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Game",
    "shortDescription": "Game library and playtime tracker",
    "longDescription": "Vaultime is a local-first game library and playtime tracker. It records runtime, active and idle time for every session in a hash-chained local log, and can back up to an optional invite-only server.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "games",
        "files": {
          "/usr/share/metainfo/com.vaultime.app.metainfo.xml": "../../../packaging/linux/com.vaultime.app.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/share/metainfo/com.vaultime.app.metainfo.xml": "../../../packaging/linux/com.vaultime.app.metainfo.xml"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1NjE2NDAwNzE1QUYxRDYKUldUVzhWcHhBR1JoSlFBRjhJUUdsL0o0Zy90cGN0RjVsMEZTT0lHZDRWdDZxWENCME01Q0lUMWwK",
      "endpoints": [
        "https://vaultime.codfishcloud.de/downloads/latest.json"
      ]
    }
  }
}
