{
  "$schema": "https://raw.githubusercontent.com/nicorbtt/tauri-v2-nightly-schema/main/schema/2.0.0/tauri.conf.json",
  "productName": "Vaultime",
  "version": "0.1.0",
  "identifier": "com.vaultime.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vaultime",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Universal game library and trustworthy playtime tracker",
    "longDescription": "Vaultime is a local-first, cross-platform game playtime tracker that records active and runtime sessions with integrity verification. Optional cloud sync and backup are available with a Pro subscription.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "games"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/schwimmbeck/vaultime/releases/latest/download/latest.json"
      ]
    }
  }
}
