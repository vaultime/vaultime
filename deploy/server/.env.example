# The address players type in Vaultime, without https://. It stays set behind
# a reverse proxy of your own too.
VAULTIME_DOMAIN=vaultime.example.com

# Three different random values, each from: openssl rand -hex 32
POSTGRES_PASSWORD=
VAULTIME_ACCESS_TOKEN_SECRET=
VAULTIME_REFRESH_TOKEN_PEPPER=

# Lets new accounts in. With a sign-up code below, only people you gave the
# code can create one, and sign-ups can stay open. Without a code anyone who
# reaches the server can, so then set this to false once your friends joined
# and run docker compose up -d again.
VAULTIME_OPEN_SIGNUPS=true

# The code new accounts need, at least 8 characters, for example three words
# of your choice. Capitals count. Use letters, digits, dashes and spaces, as
# Docker Compose reads $ and # in this file itself. Change it and run
# docker compose up -d again if it reached the wrong people. Accounts that
# exist keep working.
VAULTIME_SIGNUP_CODE=

# A version to stay on instead of the newest one.
#VAULTIME_VERSION=0.7.0

# The port on this machine for a reverse proxy of your own.
#VAULTIME_PORT=8080
