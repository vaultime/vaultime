[Unit]
Description=Vaultime database dump
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
# One custom format dump per day. Each run then deletes the dumps that are at
# least 15 days old, so a dump stays for 15 to 16 days.
ExecStart=/bin/sh -c 'pg_dump --format=custom --file=/var/backups/vaultime/vaultime-$(date +%%Y-%%m-%%d).dump vaultime'
ExecStartPost=/usr/bin/find /var/backups/vaultime -name 'vaultime-*.dump' -mtime +14 -delete

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/backups/vaultime
